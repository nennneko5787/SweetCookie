{
  "format_version": "1.21.0",
  "minecraft:block": {
    "description": {
      "identifier": "sc_conformance:ledge",
      "states": {
        "sc:shape": ["slab", "post", "open", "grown"]
      },
      "menu_category": { "category": "construction" }
    },
    "components": {
      "minecraft:collision_box": {
        "origin": [-8, 0, -8],
        "size": [16, 8, 16]
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, -8],
        "size": [16, 8, 16]
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('sc:shape') == 'post'",
        "components": {
          "minecraft:collision_box": {
            "origin": [-2, 0, -2],
            "size": [4, 16, 4]
          },
          "minecraft:selection_box": {
            "origin": [-2, 0, -2],
            "size": [4, 16, 4]
          }
        }
      },
      {
        "condition": "query.block_state('sc:shape') == 'open'",
        "components": {
          "minecraft:collision_box": false
        }
      },
      {
        "condition": "query.block_state('sc:shape') == 'grown'",
        "components": {
          "minecraft:collision_box": {
            "origin": [-8, 0, -8],
            "size": [64, 64, 64]
          },
          "minecraft:selection_box": true
        }
      }
    ]
  }
}
