{
  "format_version": "1.16.100",
  "minecraft:attachable": {
    "description": {
      "identifier": "lepus:probe_pre",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/blocks/wool_colored_red" },
      "geometry": { "default": "geometry.lepus_probe" },
      "animations": {
        "main_hand": "animation.lepus_probe.full",
        "off_hand": "animation.lepus_probe.full"
      },
      "scripts": {
        "pre_animation": [
          "v.main_hand = c.item_slot == 'main_hand';",
          "v.off_hand = c.item_slot == 'off_hand';"
        ],
        "animate": [
          { "main_hand": "v.main_hand && c.is_first_person" },
          { "off_hand": "v.off_hand && c.is_first_person" }
        ]
      },
      "render_controllers": [ "controller.render.item_default" ]
    }
  }
}
